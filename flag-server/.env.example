# Copy to .env and edit. Then: docker compose up -d --build

# Every challenge this server will answer for. Docker challenges use their
# WEB id; the ones with no service use their SIM id.
VEC_CHALLENGES=WEB01,WEB02,WEB03,WEB04,WEB05,WEB06,WEB07,WEB08,WEB09,WEB10,SIM-23,SIM-24,SIM-25,SIM-26,SIM-27,SIM-28,SIM-29,SIM-30,SIM-31,SIM-32,SIM-33,SIM-34,SIM-36

# First run only. Once tokens exist in the volume, set this to 0.
VEC_ALLOW_EMPTY_TOKENS=1
